# Contact form (src/app/api/contact/route.ts) sends from your own Gmail with Nodemailer.
# 1. Turn on 2-Step Verification for the Google account.
# 2. Create an App Password at https://myaccount.google.com/apppasswords
# 3. Set these in .env.local (never in this file) and in
#    Vercel → Project → Settings → Environment Variables, then redeploy.
# Without them, /contact shows an "Email me directly" fallback instead of the form.
SMTP_USER=
# The 16-character App Password (spaces optional), not your Gmail password.
SMTP_PASS=
# Optional. Where messages go; defaults to profile.email.
CONTACT_TO=
# Optional, only for a provider other than Gmail (defaults: smtp.gmail.com, 465).
SMTP_HOST=
SMTP_PORT=